{
  "designSystem": {
    "name": "Customer-Centric Landing Page Design System",
    "version": "1.0.0",
    "description": "A conversion-focused landing page design system emphasizing social proof, customer outcomes, and friction reduction",
    
    "layout": {
      "structure": "two-column-hero",
      "grid": {
        "columns": 12,
        "leftColumn": {
          "span": "5-6 columns",
          "contentType": "text-and-cta"
        },
        "rightColumn": {
          "span": "6-7 columns",
          "contentType": "visual-media"
        }
      },
      "spacing": {
        "containerMaxWidth": "1400px",
        "contentPadding": "80-120px vertical, 40-60px horizontal",
        "sectionGap": "40-60px",
        "elementGap": "20-32px"
      },
      "alignment": {
        "leftColumn": "left-aligned",
        "rightColumn": "center-aligned"
      }
    },

    "navigation": {
      "layout": "horizontal-bar",
      "position": "top-fixed",
      "structure": [
        {
          "element": "logo",
          "position": "left",
          "size": "medium",
          "style": "minimal-border"
        },
        {
          "element": "phone-number",
          "position": "right-center",
          "includesIcon": true,
          "iconStyle": "circular-filled"
        },
        {
          "element": "cta-button",
          "position": "right",
          "style": "outlined"
        }
      ],
      "spacing": {
        "height": "80-100px",
        "padding": "20-30px horizontal"
      }
    },

    "typography": {
      "hierarchy": {
        "label": {
          "purpose": "social-proof-indicator",
          "size": "12-14px",
          "weight": "500-600",
          "transform": "uppercase",
          "letterSpacing": "0.05-0.1em",
          "color": "neutral-dark"
        },
        "h1": {
          "purpose": "main-headline",
          "size": "48-72px",
          "weight": "700-800",
          "lineHeight": "1.1-1.2",
          "letterSpacing": "-0.02em",
          "color": "primary-black",
          "maxWidth": "600-700px"
        },
        "body-large": {
          "purpose": "subheadline-description",
          "size": "16-20px",
          "weight": "400-500",
          "lineHeight": "1.5-1.6",
          "color": "neutral-dark",
          "maxWidth": "550-650px"
        },
        "body-small": {
          "purpose": "supporting-text-fud-reducer",
          "size": "14-16px",
          "weight": "400-500",
          "lineHeight": "1.5",
          "color": "neutral-medium"
        },
        "button-text": {
          "size": "16-18px",
          "weight": "600-700",
          "transform": "uppercase",
          "letterSpacing": "0.05em"
        }
      },
      "fontStack": {
        "primary": "sans-serif system fonts (Inter, SF Pro, Roboto style)",
        "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      }
    },

    "colorPalette": {
      "philosophy": "minimal, high contrast, accent-driven",
      "colors": {
        "primary": {
          "black": "#000000 or #1a1a1a",
          "usage": "headlines, primary text"
        },
        "accent": {
          "vibrant": "#6B46FF or similar saturated purple/blue",
          "usage": "CTA buttons, interactive elements, brand emphasis"
        },
        "neutrals": {
          "dark": "#333333 - #4a4a4a",
          "medium": "#666666 - #808080",
          "light": "#e5e5e5 - #f5f5f5",
          "white": "#ffffff",
          "usage": "backgrounds, borders, supporting text"
        },
        "accents-secondary": {
          "phone-icon": "#3b82f6 or similar blue",
          "usage": "contact elements, trust indicators"
        }
      }
    },

    "components": {
      "buttons": {
        "primary-cta": {
          "style": "filled",
          "background": "vibrant accent color",
          "textColor": "white",
          "padding": "18-24px vertical, 40-60px horizontal",
          "borderRadius": "8-12px",
          "fontSize": "16-18px",
          "fontWeight": "600-700",
          "textTransform": "uppercase",
          "shadow": "subtle or none",
          "hoverEffect": "slight darken or scale(1.02)"
        },
        "secondary-cta": {
          "style": "outlined",
          "border": "2px solid neutral-dark",
          "textColor": "neutral-dark",
          "background": "transparent",
          "padding": "12-16px vertical, 24-36px horizontal",
          "borderRadius": "6-8px",
          "hoverEffect": "background fill with subtle color"
        }
      },

      "contactElement": {
        "phoneNumber": {
          "layout": "icon + text horizontal",
          "iconStyle": "circular filled background",
          "iconSize": "40-50px",
          "iconColor": "blue accent",
          "textSize": "20-24px",
          "textWeight": "700",
          "spacing": "12-16px gap"
        }
      },

      "socialProof": {
        "label": {
          "position": "above headline",
          "style": "uppercase small text",
          "margin": "0 0 16-24px 0"
        }
      },

      "mediaContainer": {
        "style": "bordered box",
        "border": "2-3px solid black",
        "borderRadius": "0 or 8-12px",
        "padding": "40-60px",
        "background": "white or light neutral",
        "aspectRatio": "flexible, typically 4:3 or 16:9",
        "contentAlignment": "center",
        "placeholderText": {
          "size": "18-24px",
          "weight": "500-600",
          "color": "neutral-dark",
          "lineHeight": "1.5"
        }
      },

      "fudReducer": {
        "position": "below CTA button",
        "margin": "24-32px top",
        "style": "simple text",
        "fontSize": "14-16px",
        "fontWeight": "400-500",
        "color": "neutral-dark",
        "format": "UPPERCASE label: followed by comma-separated items in parentheses"
      }
    },

    "contentStructure": {
      "heroSection": {
        "elements": [
          {
            "order": 1,
            "type": "social-proof-label",
            "format": "SOCIAL PROOF #[number]"
          },
          {
            "order": 2,
            "type": "headline",
            "formula": "[Dream Outcome] and '[What's In It For Me]'",
            "style": "customer benefit focused, not feature focused"
          },
          {
            "order": 3,
            "type": "subheadline",
            "formula": "[Pain point quote] | [Solution statement]",
            "length": "2-3 lines maximum"
          },
          {
            "order": 4,
            "type": "primary-cta",
            "text": "Action-oriented verb phrase (uppercase)"
          },
          {
            "order": 5,
            "type": "fud-reducer",
            "format": "REDUCE [Category] and [Acronym] ([comma, separated, items])"
          }
        ]
      }
    },

    "designPrinciples": {
      "visual": [
        "High contrast between elements",
        "Generous white space",
        "Clear visual hierarchy through size and weight",
        "Minimal decorative elements",
        "Strong geometric shapes (rectangles, circles)",
        "Clean borders to define sections"
      ],
      "conversion": [
        "Customer outcome focused, not feature focused",
        "Social proof placement above headline",
        "Single primary CTA per section",
        "Explicit friction reduction messaging",
        "Visual reinforcement of value proposition",
        "Clear call-to-action hierarchy"
      ],
      "content": [
        "Pain point identification",
        "Benefit articulation",
        "Unique mechanism or approach",
        "Trust building elements",
        "Action-oriented language"
      ]
    },

    "responsiveBreakpoints": {
      "desktop": ">1200px - two column layout",
      "tablet": "768-1200px - maintain two columns, adjust spacing",
      "mobile": "<768px - stack to single column, media container above or below text"
    },

    "animations": {
      "philosophy": "subtle and purposeful",
      "elements": {
        "ctaButton": "hover scale or color transition (200-300ms)",
        "links": "underline animation or color fade (200ms)",
        "onScroll": "optional fade-in for sections (300-500ms)",
        "heroEntry": "optional stagger for headline/cta (100-200ms delay)"
      }
    },

    "usageGuidelines": {
      "whenToUse": [
        "Landing pages with clear conversion goal",
        "Hero sections for service-based businesses",
        "Product launch pages",
        "Lead generation pages"
      ],
      "keyElements": [
        "Always include social proof indicator",
        "Customer-centric headline formula",
        "Single clear CTA",
        "Visual content that demonstrates value",
        "Friction reduction statement"
      ],
      "variations": [
        "Swap left/right columns for variety",
        "Add video instead of static image",
        "Include trust badges or testimonial count",
        "Add secondary supporting text between subhead and CTA"
      ]
    }
  }
}